<?xml version="1.0"?>
<ruleset name="WPForge Coding Standards">
    <description>WPForge PHP coding standards</description>

    <arg name="extensions" value="php"/>

    <!-- Paths -->
    <file>wordpress/wpforge/src</file>
    <file>wordpress/wpforge/routes</file>
    <file>wordpress/wpforge/wpforge.php</file>
    <file>wordpress/wpforge/uninstall.php</file>
    <file>tests</file>
    <file>tools</file>

    <!-- Exclude -->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>mcp/*</exclude-pattern>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress-Phpcs">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec"/>
    </rule>

    <!-- PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Security -->
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
</ruleset>
