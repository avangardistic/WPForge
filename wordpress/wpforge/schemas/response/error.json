{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Error Response",
    "type": "object",
    "properties": {
        "success": { "type": "boolean", "const": false },
        "request_id": { "type": "string" },
        "error": {
            "type": "object",
            "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
            },
            "required": ["code", "message"]
        }
    },
    "required": ["success", "request_id", "error"]
}
